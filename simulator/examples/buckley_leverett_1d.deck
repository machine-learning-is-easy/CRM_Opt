# One-dimensional Buckley-Leverett waterflood.
# The regression test uses a smaller in-memory variant of this case to compare
# the simulated shock location with the analytical Corey fractional-flow estimate.

nx = 40
ny = 1
nz = 1
dx = 1.0
dy = 1.0
dz = 1.0

porosity = 0.25
permeability = 100.0

mu_w = 1.0
mu_o = 2.0
swc = 0.20
sor = 0.20
nw = 2.0
no = 2.0

initial_pressure = 200.0
initial_sw = 0.20

cfl = 0.40
dt = 0.10
total_time = 2.0
output_interval = 0.5

output_dir = ./output/buckley_leverett_1d
output_prefix = buckley_leverett_1d

well INJ injector 0 0 0 rate=0.25 radius=0.10
well PROD producer 39 0 0 bhp=100.0 radius=0.10
